{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnipress.dev/schemas/documentary_recipe.schema.json",
  "title": "OmniPress Documentary Recipe",
  "description": "Declarative documentary episode / scene recipe consumed by UniversalDocumentaryEngine. Every scene requires an authentic visual asset (anti-bare-table standard).",
  "type": "object",
  "required": ["scenes"],
  "additionalProperties": true,
  "definitions": {
    "scene": {
      "type": "object",
      "required": ["id", "type", "media", "duration_seconds"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "ken_burns",
            "archive_photo",
            "tactical_map",
            "document_card",
            "portrait",
            "stat_card",
            "closing_card"
          ]
        },
        "media": {
          "type": "string",
          "description": "Authentic visual foundation. Bare text tables are rejected."
        },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "start_seconds": { "type": "number", "minimum": 0 },
        "headline": { "type": "string" },
        "subheadline": { "type": "string" },
        "badge": { "type": "string" },
        "overlay_text": { "type": "string" },
        "camera": { "enum": ["slow_zoom_in", "slow_zoom_out", "pan_left", "pan_right", "static"] },
        "transition": { "enum": ["cut", "whip_pan", "flash", "dissolve"] },
        "top_bias": { "type": "number", "minimum": 0, "maximum": 1 },
        "contrast_boost": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "channel_slug": { "type": "string" },
    "episode_slug": { "type": "string" },
    "title": { "type": "string" },
    "language": { "type": "string" },
    "aspect_ratio": { "enum": ["16:9", "9:16"] },
    "mode": { "enum": ["render", "manifest"], "description": "'render' draws cards over media; 'manifest' reuses pre-rendered scene cards." },
    "fps": { "type": "integer", "minimum": 1 },
    "theme": { "type": "object", "additionalProperties": true },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    },
    "captions": { "type": "string" },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "voiceover": { "type": "string" },
        "soundtrack": { "type": "string" },
        "soundtrack_volume": { "type": "number", "minimum": 0, "maximum": 0.2 }
      }
    },
    "outputs": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
