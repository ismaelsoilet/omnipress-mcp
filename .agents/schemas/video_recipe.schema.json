{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnipress.dev/schemas/video_recipe.schema.json",
  "title": "OmniPress Video Recipe",
  "description": "Declarative Remotion render recipe consumed by UniversalVideoEngine.",
  "type": "object",
  "required": ["composition"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "channel_slug": { "type": "string" },
    "episode_slug": { "type": "string" },
    "composition": { "type": "string" },
    "entry_point": {
      "type": "string",
      "description": "Project-relative Remotion entry point, e.g. channels/<slug>/video/episodes/<episode>/index.ts"
    },
    "public_dir": {
      "type": "string",
      "description": "Project-relative public directory for staticFile() assets"
    },
    "media_manifest": {
      "type": "string",
      "description": "Project-relative media.json manifest for deterministic staging"
    },
    "normalize_media": { "type": "boolean", "default": true },
    "stage_legacy_media": { "type": "boolean", "default": true },
    "prune_media": { "type": "boolean", "default": false },
    "editable": { "type": "boolean", "default": false },
    "props": { "type": "object", "additionalProperties": true },
    "output": { "type": "string" },
    "codec": { "enum": ["h264", "h265", "vp8", "vp9", "prores"] },
    "fps": { "type": "integer", "minimum": 1 },
    "duration_frames": { "type": "integer", "minimum": 1 },
    "aspect_ratio": { "enum": ["16:9", "9:16", "1:1", "4:5", "3:4"] },
    "preview": { "type": "boolean" },
    "outputs": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
