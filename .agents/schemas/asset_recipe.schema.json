{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnipress.dev/schemas/asset_recipe.schema.json",
  "title": "OmniPress Public Asset Recipe",
  "description": "Declarative public-domain / open-license asset acquisition recipe. Domains must be explicitly allowlisted.",
  "type": "object",
  "required": ["query", "output"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "channel_slug": { "type": "string" },
    "provider": { "enum": ["stock_asset"] },
    "source_allowlist": {
      "type": "array",
      "items": {
        "enum": [
          "commons.wikimedia.org",
          "upload.wikimedia.org",
          "loc.gov",
          "www.loc.gov",
          "archives.gov",
          "www.archives.gov",
          "nara.gov"
        ]
      }
    },
    "query": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "attribution": { "type": "string" },
    "aspect_ratio": { "enum": ["16:9", "9:16", "1:1", "4:5", "3:4"] },
    "top_bias": { "type": "number", "minimum": 0, "maximum": 1 },
    "output": { "type": "string" }
  }
}
