# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/

# Environment secrets
.env
.env.local

# Generated content archives (keep only directory structure)
articles/*
!articles/.gitkeep

# Local media assets & private historical materials
media/assets/*
!media/assets/.gitkeep
media/historical/
media/output/*
media/staging/*
!media/.gitkeep

# Channel workspaces: custom/private channels are strictly ignored, keeping only the generic template
channels/*
!channels/_template/
!channels/_template/**
!channels/.gitkeep
public/dossie/

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store

# Node & Remotion
node_modules/
.remotion/

# Heavy audio and video media files
*.mp4
*.m4a
*.wav
*.mp3
*.mov
*.avi
*.mkv
