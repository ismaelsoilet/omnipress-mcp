# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/

# Environment secrets
.env
.env.local

# Local runtime media cache & web-server staging (Rule 04: content belongs in channels/<slug>/)
media/output/*
media/staging/*
media/historical/

# Channel workspaces: custom/private channels are strictly ignored, keeping only the generic template
channels/*
!channels/_template/
!channels/_template/**
!channels/.gitkeep
# Remotion public directory: local assets & mounts are strictly ignored, keeping only the root structure
public/*
!public/.gitkeep


# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store

# Node & Remotion
node_modules/
.remotion/

# Heavy audio and video media files
*.mp4
*.m4a
*.wav
*.mp3
*.mov
*.avi
*.mkv

# Temporary scratchpad
scratch/

# Command Code agent state (taste/plans)
.commandcode/
