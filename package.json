{
  "name": "omnipress-mcp",
  "version": "0.6.0",
  "description": "Agentic multi-channel publishing engine for Antigravity via Model Context Protocol (MCP)",
  "main": "src/video/index.ts",
  "scripts": {
    "start": "python src/server.py",
    "start:http": "python src/server.py --http 3333",
    "setup:claude": "node scripts/setup_claude.js",
    "test": "uv run pytest tests/",
    "typecheck": "tsc --noEmit",
    "remotion:preview": "remotion preview src/video/index.ts",
    "remotion:render": "remotion render src/video/index.ts",
    "remotion:render:intro": "remotion render src/video/index.ts ChannelIntro-16x9 out/intro_16x9.mp4",
    "remotion:render:intro:shorts": "remotion render src/video/index.ts ChannelIntro-9x16 out/intro_9x16.mp4",
    "remotion:skills:update": "remotion skills update"
  },
  "keywords": [
    "antigravity",
    "mcp",
    "model-context-protocol",
    "publishing",
    "linkedin",
    "twitter",
    "tax",
    "legaltech",
    "govtech",
    "automation"
  ],
  "author": "OmniPress Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismaelsoilet/omnipress-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ismaelsoilet/omnipress-mcp/issues"
  },
  "homepage": "https://github.com/ismaelsoilet/omnipress-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/media-utils": "^4.0.535",
    "@remotion/transitions": "^4.0.535",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535",
    "typescript": "^7.0.2"
  }
}
