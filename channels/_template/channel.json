{
  "$schema": "../../.agents/schemas/channel.schema.json",
  "id": "template-channel",
  "name": "Nome do Perfil ou Canal",
  "slug": "template-channel",
  "archetype": "personal_brand",
  "description": "Perfil pessoal ou canal de conteúdo para distribuição multicanal.",
  "category": "tecnologia",
  "features": {
    "articles": true,
    "carousels": true,
    "social_posts": true,
    "video": false
  },
  "branding": {
    "handle": "@seuperfil",
    "badge_text": "TECH & ARQUITETURA",
    "theme_colors": {
      "primary": "#3B82F6",
      "background": "#0F172A",
      "text": "#FFFFFF",
      "secondary_text": "#E2E8F0"
    },
    "typography": {
      "bold_font": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
      "regular_font": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
    }
  },
  "visual_identity": {
    "default_preset": "tweet_card",
    "palette": {
      "primary": "#3B82F6",
      "background": "#FFFFFF",
      "card_background": "#F8FAFC",
      "text": "#0F172A",
      "secondary_text": "#64748B",
      "accent": "#F59E0B",
      "border": "#E2E8F0"
    },
    "typography": {
      "font_family": "sans",
      "bold_font": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
      "regular_font": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
      "serif_bold_font": "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf",
      "serif_regular_font": "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
      "mono_font": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
    },
    "author": {
      "name": "Nome do Autor",
      "handle": "@seuperfil",
      "title": "Engenheiro de Software & Criador",
      "avatar_path": "media/raw/avatar.jpg",
      "verified": true
    },
    "elements": {
      "bullet_style": "square",
      "watermark_text": "OMNIPRESS",
      "enable_shadow": true
    },
    "layout_parameters": {
      "margin_ratio": 0.075,
      "headline_scale": 0.054,
      "body_scale": 0.038,
      "footer_scale": 0.022,
      "border_radius": 18,
      "card_bg_alpha": 215,
      "avatar_size_ratio": 0.09,
      "show_verified_badge": true
    },
    "presets": {
      "classic_card": {
        "layout_parameters": {
          "margin_ratio": 0.065,
          "headline_scale": 0.046,
          "line_height_head": 1.25,
          "card_bg_alpha": 215
        }
      },
      "tweet_card": {
        "layout_parameters": {
          "margin_ratio": 0.075,
          "headline_scale": 0.054,
          "line_height_head": 1.25
        }
      },
      "minimal_dark": {
        "layout_parameters": {
          "margin_ratio": 0.08,
          "headline_scale": 0.046
        }
      },
      "split_editorial": {
        "layout_parameters": {
          "split_ratio": 0.44,
          "margin_ratio": 0.08
        }
      }
    },
    "semantic_tags": {
      "DICA": "#8B5CF6",
      "IMPORTANTE": "#F59E0B",
      "ATENÇÃO": "#DC2626",
      "SUCESSO": "#059669"
    },
    "semantic_categories": {
      "danger": ["MITO", "ERRO", "FALSO", "PROBLEMA", "NÃO", "PERIGO", "ATENÇÃO", "RISCO", "DESVANTAGEM", "FAIL", "BUG", "MYTH", "WRONG", "ERROR", "DANGER"],
      "success": ["VERDADE", "FATO", "CORRETO", "SOLUÇÃO", "SIM", "VANTAGEM", "CERTO", "SUCESSO", "TRUTH", "FACT", "CORRECT", "SOLUTION"],
      "warning": ["AVISO", "NOTA", "ALERTA", "IMPORTANTE", "WARNING", "NOTE", "ALERT", "OBS"]
    }
  },
  "social": {
    "linkedin": {
      "handle": "seunome",
      "profile_id": "",
      "buffer_channel_id": ""
    },
    "x_twitter": {
      "handle": "seunome",
      "buffer_channel_id": ""
    },
    "instagram": {
      "handle": "seunome",
      "buffer_channel_id": "",
      "default_hashtags": [
        "#tecnologia",
        "#software",
        "#desenvolvimento"
      ]
    },
    "threads": {
      "handle": "seunome",
      "buffer_channel_id": ""
    },
    "youtube": {
      "channel_id": "",
      "buffer_channel_id": "",
      "default_privacy": "public"
    },
    "devto": {
      "username": "seunome",
      "organization": ""
    },
    "ghost_substack": {
      "publication_url": ""
    }
  },
  "video": {
    "enabled": false,
    "voice": "",
    "language": "",
    "channel_name": "NOME DO CANAL",
    "badge_text": "CONTEÚDO OFICIAL // NÍVEL 1",
    "sub_text": "HISTÓRIAS, CURIOSIDADES E INVESTIGAÇÕES",
    "classified_code": "REF // CANAL-OFICIAL",
    "primary_color": "#3B82F6",
    "background_color": "#0B1220",
    "default_aspect_ratio": "9:16",
    "standard_short_duration_sec": 65.0,
    "caption_highlight_words": []
  },
  "render": {
    "theme": {
      "primary": "#3B82F6",
      "accent": "#3B82F6",
      "background": "#0B1220"
    },
    "providers": {},
    "blender": {
      "enabled": false,
      "binary_env": "BLENDER_PATH",
      "engine": "BLENDER_EEVEE_NEXT",
      "samples": 32,
      "factory_startup": true,
      "transparent_default": true,
      "color_management": "",
      "resolution_by_ratio": {
        "16:9": "1920x1080",
        "9:16": "1080x1920",
        "1:1": "1080x1080"
      },
      "template_allowlist": []
    }
  },
  "settings": {
    "auto_sanitize": true,
    "sanitize_profiles": ["br"],
    "default_aspect_ratio": "4:5"
  }
}
